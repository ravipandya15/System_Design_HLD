      "isDeleted": false,
      "boundElements": null,
      "updated": 1791107146725,
      "created": 1791101331432,
      "link": null,
      "locked": false,
      "text": "This query is super super slow\nClickDB is casandra which is heavily optimized for high writes,\nbut not on read queries (specially like this)\nEven DynamoDB or Postgres can't be used.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This query is super super slow\nClickDB is casandra which is heavily optimized for high writes,\nbut not on read queries (specially like this)\nEven DynamoDB or Postgres can't be used.",
      "autoResize": true,
      "lineHeight": 1.25,
