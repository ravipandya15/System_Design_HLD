    {
      "id": "nteoAyjXtEG8jHTioSTpf",
      "type": "text",
      "x": 1293.465422785554,
      "y": 4235.462062096067,
      "width": 800,
      "height": 160,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 374464460,
      "version": 653,
      "versionNonce": 173538804,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791107813194,
      "created": 1791107659381,
      "link": null,
      "locked": false,
      "text": "In Data processing architecture, we have 2 architecture choice.\n1. Kappa, 2. Lamda\nKappa is what we used with stream processor and Flink, where there are real time data\nprocessing\nLamda is what we had with Spark jobs. It has 5 mins of match interval, so during that\ntime, any other process will send inaccurate data to OLAP and after 5 min, Spark sends\ncorrect data, so there will be overlapping but it says that during that 5 mins of time,\nyou have incorrect data and after 5 mins you have correct data.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Data processing architecture, we have 2 architecture choice.\n1. Kappa, 2. Lamda\nKappa is what we used with stream processor and Flink, where there are real time data processing\nLamda is what we had with Spark jobs. It has 5 mins of match interval, so during that time, any other process will send inaccurate data to OLAP and after 5 min, Spark sends correct data, so there will be overlapping but it says that during that 5 mins of time, you have incorrect data and after 5 mins you have correct data.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
