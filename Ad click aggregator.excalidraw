      "type": "text",
      "x": 2490.884937655676,
      "y": 657.1735493706437,
      "width": 404.7994384765625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
