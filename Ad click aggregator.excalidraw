    {
      "id": "zIGvefE_cdJjGNn0zCjLA",
      "type": "text",
      "x": 1973.8196681231816,
      "y": 3542.773681118849,
      "width": 175.999755859375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
