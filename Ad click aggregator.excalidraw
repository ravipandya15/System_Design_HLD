    {
      "id": "shXrT-b49W6gJw-pJku3u",
      "type": "text",
      "x": 1294.999843854334,
      "y": 4438.927640919003,
      "width": 800,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 1682593780,
      "version": 1219,
      "versionNonce": 900587212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791108822355,
      "created": 1791108279706,
      "link": null,
      "locked": false,
      "text": "For Idempotency:\nI can create ad impression Id. (If userA clicks IdA but on different days, that's a\ndifferent impression Id, and we should count it. Here we can alter days to few hours)\n\nMain crux:\n\nIf I only generate Idempotency key, malicious brower with some bot can send different\nidempotency key ( with one character change ).\n\nCreate a signed impression Id ( with private key of server ), so client will send userId,\naddId, impression Id and signed impression Id, here if impressionId is altered, then we\ncompare sign and know that it's not legitimate request. With impressionId, generate\nsignedCopy again and compare both signed copy.\nSo for security and validity - use signed impressionId.\n\nOnce signed impressionId verified, now check if it's in redis, no then it's 1st time.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For Idempotency:\nI can create ad impression Id. (If userA clicks IdA but on different days, that's a different impression Id, and we should count it. Here we can alter days to few hours)\n\nMain crux:\n\nIf I only generate Idempotency key, malicious brower with some bot can send different idempotency key ( with one character change ).\n\nCreate a signed impression Id ( with private key of server ), so client will send userId, addId, impression Id and signed impression Id, here if impressionId is altered, then we compare sign and know that it's not legitimate request. With impressionId, generate signedCopy again and compare both signed copy.\nSo for security and validity - use signed impressionId.\n\nOnce signed impressionId verified, now check if it's in redis, no then it's 1st time.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
