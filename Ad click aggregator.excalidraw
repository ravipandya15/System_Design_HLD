      "updated": 1791107146725,
      "created": 1791106356755,
      "link": null,
      "locked": false,
      "text": "Enable retention policy in Kafka - 7 days\nEven Flink goes down, once it's back it can continue reading from the last flush.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enable retention policy in Kafka - 7 days\nEven Flink goes down, once it's back it can continue reading from the last flush.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
