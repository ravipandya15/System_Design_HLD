    {
      "id": "JK1GEIN7mxi6mGNRZ1ELl",
      "type": "text",
      "x": 1294.8626720068949,
      "y": 4027.522447431902,
      "width": 800,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1g",
      "roundness": null,
      "seed": 956354124,
      "version": 582,
      "versionNonce": 1453470156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791107146725,
      "created": 1791106500977,
      "link": null,
      "locked": false,
      "text": "Checkpointing in Flink:\n- If for entire dat (24 hours), data is in-memory and on 23rd hour, if Flink goes down, we\nwill lost all data.\nEvery 15 mins, push these data to S3, so data remains persistent.\nBut we really do not need checking pointing as our aggregator window is too small ( 1 min\n)\n\nRule of thump: if aggregator window < 5 mins and based on data flow, not use checkpoint.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Checkpointing in Flink:\n- If for entire dat (24 hours), data is in-memory and on 23rd hour, if Flink goes down, we will lost all data.\nEvery 15 mins, push these data to S3, so data remains persistent.\nBut we really do not need checking pointing as our aggregator window is too small ( 1 min )\n\nRule of thump: if aggregator window < 5 mins and based on data flow, not use checkpoint.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
