    {
      "id": "TeOurG1qyM-ETOaw4x4oB",
      "type": "text",
      "x": 200.7222084078043,
      "y": 1256.267413937664,
      "width": 358.1582129746441,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
