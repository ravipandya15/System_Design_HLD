    {
      "id": "dga4Uphc4VagPJvYcQ5MO",
      "type": "text",
      "x": 2923.8066794440238,
      "y": 1553.3320160125086,
      "width": 800,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 519295180,
      "version": 491,
      "versionNonce": 1271542732,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791107146725,
      "created": 1791101954299,
      "link": null,
      "locked": false,
      "text": "Two reasons to separate write and read optimised DB\n\n1. Reduces contention and resource competition \n        - This will improve performance\n        - If only single DB like Postgres then (Lot of writes coming in, your reads will\nbe slow because they're waiting to get a thread)\n        - Write path is fast and read path is slow\n2. Fault isolation - Issues in write path won't affect read path and visa-versa.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two reasons to separate write and read optimised DB\n\n1. Reduces contention and resource competition \n        - This will improve performance\n        - If only single DB like Postgres then (Lot of writes coming in, your reads will be slow because they're waiting to get a thread)\n        - Write path is fast and read path is slow\n2. Fault isolation - Issues in write path won't affect read path and visa-versa.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
