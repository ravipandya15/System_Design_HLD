      "isDeleted": false,
      "boundElements": null,
      "updated": 1791107146725,
      "created": 1791101197570,
      "link": null,
      "locked": false,
      "text": "Query\n\nSelect count(*) as total_events,\n    count(DISTINCT userId) as unique_users\nfrom clickEvents\nwhere adId = 123\nand timestamp = BETWEEN 164000000 and 16400001\ngroup by adId",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Query\n\nSelect count(*) as total_events,\n    count(DISTINCT userId) as unique_users\nfrom clickEvents\nwhere adId = 123\nand timestamp = BETWEEN 164000000 and 16400001\ngroup by adId",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
