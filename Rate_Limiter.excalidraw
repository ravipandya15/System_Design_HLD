    {
      "id": "Cd8NvbphH5QlVnER1lOES",
      "type": "text",
      "x": 3258.350558969008,
      "y": 441.00497676209307,
      "width": 594,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
