    {
      "id": "OPOT5Ywl1j7fstLSfad3s",
      "type": "text",
      "x": 80.27127664865105,
      "y": 445.78501492029505,
      "width": 506,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 1147311620,
      "version": 239,
      "versionNonce": 832826628,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791047489188,
      "created": 1791047416714,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Identify users by id, IP or API key\n- Limit requests based on configurable rules\n- Return proper error headers and status codes\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- Identify users by id, IP or API key\n- Limit requests based on configurable rules\n- Return proper error headers and status codes\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Pwzh21c6cjv6UJ-gQKDn1",
      "type": "text",
      "x": 92.03133820168125,
      "y": 589.1174012839315,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 608263044,
      "version": 3,
      "versionNonce": 823627708,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791047495220,
      "created": 1791047491496,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
