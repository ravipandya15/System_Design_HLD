      "version": 321,
      "versionNonce": 582529796,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791051430202,
      "created": 1791050863185,
      "link": null,
      "locked": false,
      "text": "What to return in response along with response Code?\n\n1. X-RateLimit-Limit eg. 100\n2. X-RateLimit-Remaining eg. 0\n3. X-RateLimit-Reset: Unix timestamp eg. \"16409234554\"\n4. Retry After: 60 seconds",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What to return in response along with response Code?\n\n1. X-RateLimit-Limit eg. 100\n2. X-RateLimit-Remaining eg. 0\n3. X-RateLimit-Reset: Unix timestamp eg. \"16409234554\"\n4. Retry After: 60 seconds",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
