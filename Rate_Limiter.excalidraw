    {
      "id": "FK3ZrAnBt1DulDDQPe20z",
      "type": "text",
      "x": 2576.0135587555715,
      "y": 1660.6322037653185,
      "width": 800,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 36524804,
      "version": 382,
      "versionNonce": 1476756412,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791050853996,
      "created": 1791050447952,
      "link": null,
      "locked": false,
      "text": "Lua script -> Redis internally uses Lua script\nBelow 2 steps should be Atomic\n\nLua script supprts Atomic transactions, HM Get, HM Set, Update token\ncount using single Redis lua script",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lua script -> Redis internally uses Lua script\nBelow 2 steps should be Atomic\n\nLua script supprts Atomic transactions, HM Get, HM Set, Update token count using single Redis lua script",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "D9DTAIR_p-O41DnzTT1qL",
      "type": "text",
      "x": 3262.5809182378903,
      "y": 246.5332766036995,
      "width": 528,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 1577003964,
      "version": 448,
      "versionNonce": 671280388,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791051427752,
      "created": 1791050638172,
      "link": null,
      "locked": false,
      "text": "1. Request comes in\n2. gateway fetch token and last_refill_time\nfrom redis HMGet alice:bucket tokens last_refill\n3. update counts based on rate and last refill\n4. Respond pass or fail based on if tokens > 0\n5. Update bucket status",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Request comes in\n2. gateway fetch token and last_refill_time\nfrom redis HMGet alice:bucket tokens last_refill\n3. update counts based on rate and last refill\n4. Respond pass or fail based on if tokens > 0\n5. Update bucket status",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
