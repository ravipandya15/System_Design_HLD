      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Up to you! We want to minimize the harm\ncaused.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Up to you! We want to minimize the harm caused.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
