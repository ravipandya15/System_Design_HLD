      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Do we need to find harmful comments, or\njust posts?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Do we need to find harmful comments, or just posts?",
      "autoResize": false,
