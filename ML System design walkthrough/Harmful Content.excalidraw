      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Do we have data available for the initial\ntraining or will we need to cold start?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Do we have data available for the initial training or will we need to cold start?",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "KhzGGZs_be2MwiyoAlnEe",
      "type": "text",
      "x": 490.8368835449219,
      "y": 6272.31689453125,
      "width": 744.2637329101562,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
