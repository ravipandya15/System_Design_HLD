    },
    {
      "id": "68mmDJ_RitcShOuk_SmHA",
      "type": "text",
      "x": 508.15283203125,
      "y": 6217.31689453125,
      "width": 709.6318359375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
