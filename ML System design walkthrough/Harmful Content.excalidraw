    {
      "id": "8FF9JM0gNT8GL6Jb-VN0z",
      "type": "text",
      "x": 279.1416931152344,
      "y": 4094.4246826171875,
      "width": 1092.6976318359375,
      "height": 247.66406250000009,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 1526002779,
      "version": 159,
      "versionNonce": 1266192955,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1746217927100,
      "link": null,
      "locked": false,
      "text": "1) Clarify the Problem\n2) Establish a Business Objective\n3) Decide on an ML Objective",
      "fontSize": 66.04375000000002,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Clarify the Problem\n2) Establish a Business Objective\n3) Decide on an ML Objective",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "MAzIiaLMVWIfwgPid3rqD",
      "type": "text",
      "x": 515.5509033203125,
      "y": 4767.31689453125,
      "width": 694.835693359375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 1031474491,
      "version": 33,
      "versionNonce": 768390293,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Are posts text-only or can they include\nimages, videos, or other media?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Are posts text-only or can they include images, videos, or other media?",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "QSDIrHPmep-tb1tGH8DU6",
      "type": "text",
      "x": 480.2889404296875,
      "y": 4844.81689453125,
      "width": 765.359619140625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 896776181,
      "version": 33,
      "versionNonce": 1777748795,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Posts can include text, images, and videos,\nbut let's focus on just images and text for\nthis interview to keep things simple.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Posts can include text, images, and videos, but let's focus on just images and text for this interview to keep things simple.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "7Aor011m2xcxA9PMQV8X5",
      "type": "text",
      "x": 464.32293701171875,
      "y": 5034.81689453125,
      "width": 797.2916259765625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1455140315,
      "version": 33,
      "versionNonce": 265509365,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "What kind of content do we want to detect?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What kind of content do we want to detect?",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "A3oFeQUvEyD3sBPzrFahp",
      "type": "text",
      "x": 471.9009094238281,
      "y": 5044.81689453125,
      "width": 782.1356811523438,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 1182986581,
      "version": 33,
      "versionNonce": 220146651,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "We want to detect all harmful content:\nnudity, violence, all the way to terrorism and\nhuman trafficking.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want to detect all harmful content: nudity, violence, all the way to terrorism and human trafficking.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "SJQ6Wy9ArZBVYX29lxNjk",
      "type": "text",
      "x": 497.5509033203125,
      "y": 5234.81689453125,
      "width": 730.835693359375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 207567483,
      "version": 33,
      "versionNonce": 949900117,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "What happens if we find harmful content?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What happens if we find harmful content?",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "CZD798ZHKGdqEM6ybWo37",
      "type": "text",
      "x": 463.94488525390625,
      "y": 5199.81689453125,
      "width": 798.0477294921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1478753973,
      "version": 33,
      "versionNonce": 1705179259,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "Let's assume we can automatically remove\ncontent we're confident is harmful and\ndemote likely harmful content. We also have a\nsmall team of moderators who can review\ncontent, but they will have limited capacity.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's assume we can automatically remove content we're confident is harmful and demote likely harmful content. We also have a small team of moderators who can review content, but they will have limited capacity.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "JajwvFPrZJmRfOLWhTFso",
      "type": "text",
      "x": 546.8348693847656,
      "y": 5502.31689453125,
      "width": 632.2677612304688,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 724054811,
      "version": 33,
      "versionNonce": 1954750645,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "What are the consequences of false\npositives and false negatives?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What are the consequences of false positives and false negatives?",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "HWV0USEhpGveNJ3G0xRwA",
      "type": "text",
      "x": 468.2828674316406,
      "y": 5444.81689453125,
      "width": 789.3717651367188,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 553410581,
      "version": 33,
      "versionNonce": 1631858971,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "We want to make sure people are free to\nexpress themselves, so we don't want to\nremove anything we aren't 95% confident is\nharmful. Users who have their content\nremoved incorrectly will be unhappy and may\nleave the platform. On the other hand, users\nwho are exposed to excessive harmful\ncontent may leave the platform if it hampers\ntheir experience.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We want to make sure people are free to express themselves, so we don't want to remove anything we aren't 95% confident is harmful. Users who have their content removed incorrectly will be unhappy and may leave the platform. On the other hand, users who are exposed to excessive harmful content may leave the platform if it hampers their experience.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "u-UTQLK6kSZWsaEtZHg9-",
      "type": "text",
      "x": 496.5068664550781,
      "y": 6017.31689453125,
      "width": 732.9237670898438,
      "height": 90,
