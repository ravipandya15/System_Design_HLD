      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "You're free to use comments, but we're only\ninterested in posts.",
      "fontSize": 36,
      "fontFamily": 5,
