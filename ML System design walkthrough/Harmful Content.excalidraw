      "versionNonce": 895018587,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1746219370275,
      "link": null,
      "locked": false,
      "text": "You can assume we have a small amount of\nlabelled data (50k examples, 50% harmful\nand 50% benign) available for the initial\ntraining.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can assume we have a small amount of labelled data (50k examples, 50% harmful and 50% benign) available for the initial training.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "fE9oQESs9HQG698UoLcHN",
      "type": "text",
      "x": 503.2208251953125,
      "y": 6507.31689453125,
      "width": 719.495849609375,
      "height": 90,
      "angle": 0,
