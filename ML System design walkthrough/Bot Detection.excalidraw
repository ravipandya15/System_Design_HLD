      "seed": 1643457220,
      "version": 372,
      "versionNonce": 343077060,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768683989903,
      "link": null,
      "locked": false,
      "text": "50% of all activity is bots, 1% of that remains after simple heuristics\nBots are evasive, inhuman behaviors\n500m DAU\n\nBan the bots when we find them\nAppeals are available for users, bots can navigate these appeals\n\nTeam of investigators who can look at accounts and determine if they are bots\n  ... inexact, takes a lot of time, and expensive",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "50% of all activity is bots, 1% of that remains after simple heuristics\nBots are evasive, inhuman behaviors\n500m DAU\n\nBan the bots when we find them\nAppeals are available for users, bots can navigate these appeals\n\nTeam of investigators who can look at accounts and determine if they are bots\n  ... inexact, takes a lot of time, and expensive",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
