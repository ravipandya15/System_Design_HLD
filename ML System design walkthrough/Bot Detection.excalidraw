    {
      "id": "uhs8M45WJE7hxrhUTHmLP",
      "type": "text",
      "x": 203.00786886724444,
      "y": 1990.449493804535,
      "width": 702.5391235351562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
