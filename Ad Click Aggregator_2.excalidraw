    {
      "type": "text",
      "version": 183,
      "versionNonce": 1818382582,
      "index": "bHW",
      "isDeleted": false,
      "id": "gVpt61EOKc6DudyJvjzQC",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 1809.7505861125014,
      "y": 1920.3697681666745,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 488.06365966796875,
      "height": 320,
      "seed": 812461576,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1721384327106,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "Kappa Architecture:\n\n- Designed for stream processing\n- Treats all data as a continuous stream\n- Simplifies architecture by eliminating the batch layer\n- Relies solely on the real-time processing layer\n\nLambda Architecture:\n\n- Combines both batch and stream processing\n- Has a batch layer to process historical data\n- Includes a speed layer for real-time data processing\n- Features a serving layer to merge results from both layers\n- Ensures data accuracy and real-time responsiveness\n\nOur solution is a hybrid, and yes, thats ok! :) ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kappa Architecture:\n\n- Designed for stream processing\n- Treats all data as a continuous stream\n- Simplifies architecture by eliminating the batch layer\n- Relies solely on the real-time processing layer\n\nLambda Architecture:\n\n- Combines both batch and stream processing\n- Has a batch layer to process historical data\n- Includes a speed layer for real-time data processing\n- Features a serving layer to merge results from both layers\n- Ensures data accuracy and real-time responsiveness\n\nOur solution is a hybrid, and yes, thats ok! :) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
