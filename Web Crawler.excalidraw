      "roundness": null,
      "boundElements": [],
      "updated": 1718641764588,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Data Flow:\n1. Take seed urls from a frontier and the IP from DNS\n2. Fetch HTML\n3. Extract text from HTML\n4. Store that text in database\n5. Extract the urls in the text and add to our frontier\n6. Repeat steps 1-5 until all urls have been crawled",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Flow:\n1. Take seed urls from a frontier and the IP from DNS\n2. Fetch HTML\n3. Extract text from HTML\n4. Store that text in database\n5. Extract the urls in the text and add to our frontier\n6. Repeat steps 1-5 until all urls have been crawled",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
