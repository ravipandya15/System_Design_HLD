      "seed": 1010064081,
      "version": 188,
      "versionNonce": 568942897,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1750194602511,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n1) Low-latency, 500ms\n2) High throughput (TBD)\n3) Eventually consistent, 1 min\n4) High recall, all of the posts\n5) High availability",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n1) Low-latency, 500ms\n2) High throughput (TBD)\n3) Eventually consistent, 1 min\n4) High recall, all of the posts\n5) High availability",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
