    {
      "id": "dMluHZ6oJy47zNYVpwHpc",
      "type": "text",
      "x": 417.451171875,
      "y": 1704.9053615993926,
      "width": 727.9715576171875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
