      "version": 130,
      "versionNonce": 1994361471,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1750194264357,
      "link": null,
      "locked": false,
      "text": "Non-Function Requirements\n1) Fast queries, 500ms\n2) High-volume (TBD)\n3) Posts appear in search within 1m\n4) ",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Function Requirements\n1) Fast queries, 500ms\n2) High-volume (TBD)\n3) Posts appear in search within 1m\n4) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "3C2E3biMM9UOq85KEqLOe",
      "type": "text",
      "x": 1192.1549479166667,
      "y": 1698.756273057726,
      "width": 387.68768310546875,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
