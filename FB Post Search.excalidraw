    {
      "id": "lC1zokN9E7gIXP7JJo5Ln",
      "type": "text",
      "x": 661.69921875,
      "y": 2211.0701158311635,
      "width": 497.30767822265625,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 215216881,
      "version": 242,
      "versionNonce": 1962623679,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1750195571547,
      "link": null,
      "locked": false,
      "text": "Users: 1 B\n\nWrites:\nPosts: 1 B / 100k s = 10k posts/s\nLikes: 10 B / 100k s = 100k likes/s\n\nReads:\nSearches: 1 B / 100k s = 10k searches/s\n\nStorage:\nPosts: 1 B * 365 * 10 years = 3.6 T\nStorage: 3.6T * 1kb = 3.6 pb",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Users: 1 B\n\nWrites:\nPosts: 1 B / 100k s = 10k posts/s\nLikes: 10 B / 100k s = 100k likes/s\n\nReads:\nSearches: 1 B / 100k s = 10k searches/s\n\nStorage:\nPosts: 1 B * 365 * 10 years = 3.6 T\nStorage: 3.6T * 1kb = 3.6 pb",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
